#!/bin/bash
# claude-tm — monorepo-dev shim that delegates to the Python entry point.
#
# The real launcher lives at `python -m tubemail.claude_tm` and is
# installed onto PATH as `claude-tm` by `pip install tubemail`. This
# script exists to preserve the monorepo dev workflow: it sources the
# repo-root .env (so $TUBEMAIL_SECRET is set) and then execs the Python
# launcher.
#
# Production users do NOT need this file — `pip install tubemail`
# already ships `claude-tm` on PATH. Use this only when you want the
# convenience of "I keep my .env at the monorepo root."
#
# Install (one-time, monorepo dev):
#     pip install -e tubemail/channel/ --no-build-isolation
#     ln -s "$(pwd)/tubemail/scripts/claude-tm" ~/.local/bin/claude-tm
#
# Once `pip install tubemail` lands on PyPI for real users, this shim is
# strictly optional: drop a .env in your project's cwd (or
# ~/.config/tubemail/.env) and claude-tm picks it up automatically.

set -euo pipefail

# Resolve paths: this script lives at <monorepo>/tubemail/scripts/claude-tm.
# realpath follows symlinks so it works when installed via symlink onto PATH.
SCRIPT_PATH="$(realpath "${BASH_SOURCE[0]}")"
TUBEMAIL_DIR="$(dirname "$(dirname "$SCRIPT_PATH")")"
MONOREPO_ROOT="$(dirname "$TUBEMAIL_DIR")"
ENV_FILE="$MONOREPO_ROOT/.env"

if [[ -f "$ENV_FILE" ]]; then
    set -a
    # shellcheck source=/dev/null
    source "$ENV_FILE"
    set +a
fi

# Hand off. tubemail.claude_tm handles arg parsing, pidfile checks,
# session-name resolution, and the restart loop — all of which used to
# live here in bash.
exec python -m tubemail.claude_tm "$@"
